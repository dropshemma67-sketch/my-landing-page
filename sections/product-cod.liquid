{%- liquid
  assign prod = section.settings.product
  assign variant = prod.selected_or_first_available_variant

  comment
    La galería usa las 4 imágenes de la sección. Si no cargaste ninguna,
    cae automáticamente en las fotos del producto conectado.
  endcomment
  assign main_img = section.settings.image_1
  if main_img == blank
    assign main_img = prod.featured_image
  endif
-%}

<section class="section" id="{{ section.settings.anchor | default: 'comprar' }}">
  <div class="aura" style="opacity:.42"><span class="aura__blob aura__blob--1"></span></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="buy" data-sticky-anchor>

      {%- comment -%} ---------- Galería ---------- {%- endcomment -%}
      <div class="gallery" data-gallery data-reveal="left">
        <div class="gallery__main glass">
          {%- if main_img != blank -%}
            <img data-gallery-main src="{{ main_img | image_url: width: 1200 }}" alt="{{ prod.title | default: section.settings.title | escape }}" width="1200" height="1200" loading="lazy">
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="gallery__thumbs">
          {%- if section.settings.image_1 != blank -%}
            {% render 'gallery-thumb', image: section.settings.image_1, index: 1, active: true %}
            {% render 'gallery-thumb', image: section.settings.image_2, index: 2 %}
            {% render 'gallery-thumb', image: section.settings.image_3, index: 3 %}
            {% render 'gallery-thumb', image: section.settings.image_4, index: 4 %}
          {%- elsif prod != blank -%}
            {%- for image in prod.images limit: 8 -%}
              {% render 'gallery-thumb', image: image, index: forloop.index, active: forloop.first %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- Panel de compra ---------- {%- endcomment -%}
      <div class="buy__panel glass" data-reveal="right">
        {%- if section.settings.show_rating -%}
          <div class="rating">
            {% for i in (1..5) %}{% render 'icon', name: 'star', size: 15 %}{% endfor %}
            <span class="muted">{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        <h2 class="h2" style="font-size:clamp(1.6rem,3vw,2.3rem)">{{ section.settings.title }}</h2>
        <p class="muted small" style="margin-top:-.5rem">{{ section.settings.tagline }}</p>

        {%- comment -%}
          El precio tachado sale del «Precio de comparación» del producto en
          Shopify. Se muestra solo si es mayor que el precio de venta, así el
          porcentaje siempre corresponde a un descuento que existe de verdad.
        {%- endcomment -%}
        {%- liquid
          if prod != blank
            assign now_price = prod.price
            assign was_price = prod.compare_at_price
          else
            assign now_price = 0
            assign was_price = 0
          endif
          assign has_discount = false
          if was_price > now_price and now_price > 0
            assign has_discount = true
            assign off_pct = was_price | minus: now_price | times: 100.0 | divided_by: was_price | round
          endif
        -%}
        <div class="price-row">
          {%- if prod != blank -%}
            <span class="price-row__now">{{ now_price | money_without_trailing_zeros }}</span>
            {%- if has_discount -%}
              <s class="price-row__was">{{ was_price | money_without_trailing_zeros }}</s>
              <span class="price-row__off">-{{ off_pct }}%</span>
            {%- endif -%}
          {%- else -%}
            <span class="price-row__now">{{ section.settings.price_text }}</span>
          {%- endif -%}
          {%- if section.settings.price_badge != blank -%}
            <span class="ship-free">{{ section.settings.price_badge }}</span>
          {%- endif -%}
        </div>
        {%- if has_discount and section.settings.discount_note != blank -%}
          <p class="save-line">
            {% render 'icon', name: 'check-circle', size: 15 %}
            <span>{{ section.settings.discount_note | replace: '[ahorro]', was_price | minus: now_price | money_without_trailing_zeros }}</span>
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="checklist">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check', size: 17 %}<span>{{ block.settings.text }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <hr class="hairline">

        {%- comment -%} ---------- Formulario contraentrega ---------- {%- endcomment -%}
        <form class="cod" data-cod-form
              data-cod-mode="{{ section.settings.submit_mode }}"
              data-wa-number="{{ settings.whatsapp_number }}"
              novalidate>

          <input type="hidden" data-variant-input value="{{ variant.id }}">
          <input type="hidden" data-quantity-input value="1">
          {%- comment -%}
            La talla siempre se guarda como propiedad del pedido, tengas o no
            variantes creadas en Shopify. Si las creaste, además selecciona la
            variante correcta para que el stock y el pedido salgan bien.
          {%- endcomment -%}
          <input type="hidden" data-prop="Talla" data-size-input value="">

          {%- assign size_blocks = section.blocks | where: 'type', 'size' -%}
          {%- if size_blocks.size > 0 -%}
            <div>
              <p class="tiny" style="color:var(--warm-2);margin-bottom:.55rem">Elige tu talla</p>
              <div class="packs" data-packs>
                {%- for block in size_blocks -%}
                  {%- comment -%} Busca en el producto una variante que coincida con esta talla {%- endcomment -%}
                  {%- assign matched = blank -%}
                  {%- for v in prod.variants -%}
                    {%- if v.title contains block.settings.code -%}
                      {%- assign matched = v -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <label class="pack{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                    <input type="radio" name="cod-size"
                           data-size="{{ block.settings.code }}"
                           {% if matched != blank %}data-variant="{{ matched.id }}"{% endif %}
                           {% if forloop.first %}checked{% endif %}>
                    <span class="pack__t">Talla {{ block.settings.code }}</span>
                    <span class="pack__p" style="font-weight:500;color:var(--muted);font-size:.85rem">{{ block.settings.range }}</span>
                  </label>
                {%- endfor -%}
              </div>
              {%- if section.settings.size_help != blank -%}
                <p class="cod__note" style="margin-top:.6rem">
                  {% render 'icon', name: 'info', size: 15 %}
                  <span>{{ section.settings.size_help }}</span>
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- assign qty_blocks = section.blocks | where: 'type', 'quantity' -%}
          {%- if qty_blocks.size > 0 -%}
            <div>
              <p class="tiny" style="color:var(--warm-2);margin-bottom:.55rem">Cantidad</p>
              <div class="packs" data-packs>
                {%- for block in qty_blocks -%}
                  <label class="pack{% if block.settings.featured %} pack--featured{% endif %}{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                    <input type="radio" name="cod-qty" data-qty="{{ block.settings.qty }}" {% if forloop.first %}checked{% endif %}>
                    <span class="pack__main">
                      <span class="pack__t">
                        {{ block.settings.label }}
                        {%- if block.settings.badge != blank -%}
                          <em class="pack__badge">{{ block.settings.badge }}</em>
                        {%- endif -%}
                      </span>
                      {%- if block.settings.sub != blank -%}
                        <span class="pack__sub">{{ block.settings.sub }}</span>
                      {%- endif -%}
                    </span>
                    <span class="pack__prices">
                      <span class="pack__p">{{ block.settings.price }}</span>
                      {%- if block.settings.compare != blank -%}
                        <s class="pack__was">{{ block.settings.compare }}</s>
                      {%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%}
            Modo «corto»: aquí solo se elige talla y cantidad; la dirección se
            pide una sola vez, en el checkout de Shopify. Es de donde Dropi lee
            los datos de entrega, así que pedirla dos veces solo agrega fricción.
            Modo «completo»: se piden los datos acá y se intenta prellenar el
            checkout con ellos.
          {%- endcomment -%}
          {%- if section.settings.form_mode == 'full' -%}
          <p class="tiny" style="color:var(--warm-2);margin-top:.3rem">{{ section.settings.form_title }}</p>

          <div class="field">
            <label for="cod-name">Nombre y apellido</label>
            <input id="cod-name" type="text" autocomplete="name" placeholder="Ej. María Quispe"
                   data-required data-type="text" data-prop="Nombre">
            <span class="field__err"></span>
          </div>

          <div class="two-col">
            <div class="field">
              <label for="cod-phone">Celular / WhatsApp</label>
              <input id="cod-phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="987 654 321"
                     data-required data-type="phone" data-prop="Celular">
              <span class="field__err"></span>
            </div>
            <div class="field">
              <label for="cod-region">Departamento</label>
              <select id="cod-region" data-required data-prop="Departamento">
                <option value="">Selecciona…</option>
                {%- assign regions = section.settings.regions | split: ',' -%}
                {%- for r in regions -%}
                  <option value="{{ r | strip }}">{{ r | strip }}</option>
                {%- endfor -%}
              </select>
              <span class="field__err"></span>
            </div>
          </div>

          <div class="field">
            <label for="cod-district">Distrito o ciudad</label>
            <input id="cod-district" type="text" placeholder="Ej. Miraflores"
                   data-required data-type="text" data-prop="Distrito">
            <span class="field__err"></span>
          </div>

          <div class="field">
            <label for="cod-address">Dirección exacta</label>
            <input id="cod-address" type="text" autocomplete="street-address" placeholder="Av. Larco 123, dpto. 502"
                   data-required data-type="text" data-prop="Dirección">
            <span class="field__err"></span>
          </div>

          <div class="field">
            <label for="cod-ref">Referencia (opcional)</label>
            <textarea id="cod-ref" placeholder="Frente al parque, portón negro. Horario en que te encuentran."
                      data-prop="Referencia"></textarea>
          </div>
          {%- endif -%}

          <div class="cod__status" data-cod-status role="status" aria-live="polite"></div>

          <button class="btn btn--warm btn--wide btn--lg" type="submit" data-cod-submit>
            <span class="spinner" aria-hidden="true"></span>
            <span class="btn__label">{{ section.settings.submit_text }}</span>
          </button>

          <p class="cod__note">
            {% render 'icon', name: 'shield', size: 16 %}
            <span>{{ section.settings.reassurance }}</span>
          </p>

          <div class="payline">
            {% render 'icon', name: 'lock', size: 13 %}
            <span>{{ section.settings.payline }}</span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---------- CTA fija en móvil ---------- {%- endcomment -%}
{%- if section.settings.show_sticky -%}
  <div class="sticky-cta" data-sticky-cta>
    <div class="sticky-cta__price">
      <span class="tiny muted" style="letter-spacing:.06em">Contraentrega</span>
      <b>{% if prod != blank %}{{ prod.price | money_without_trailing_zeros }}{% else %}{{ section.settings.price_text }}{% endif %}</b>
    </div>
    <a class="btn btn--warm" href="#{{ section.settings.anchor | default: 'comprar' }}">
      <span class="btn__label">{{ section.settings.sticky_text }}</span>
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Producto + contraentrega",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "comprar" },
    { "type": "header", "content": "Producto" },
    { "type": "product", "id": "product", "label": "Producto de Shopify", "info": "Obligatorio para que el pedido llegue a tu panel. El precio y el stock se toman de aquí." },
    { "type": "text", "id": "title", "label": "Título", "default": "Corrector de Postura MAERK" },
    { "type": "text", "id": "tagline", "label": "Bajada", "default": "Soporte en X · Doble ajuste · Tallas S y M · Unisex" },
    { "type": "text", "id": "price_text", "label": "Precio (si no conectas producto)", "default": "S/ 60" },
    { "type": "text", "id": "price_badge", "label": "Insignia junto al precio", "default": "Envío gratis" },
    { "type": "text", "id": "discount_note", "label": "Línea de ahorro", "default": "Precio de lanzamiento · ahorras [ahorro] hoy", "info": "Escribe [ahorro] donde quieras que aparezca el monto. Se muestra solo si el producto tiene un precio de comparación mayor en Shopify." },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar valoración", "default": true },
    { "type": "text", "id": "rating_text", "label": "Texto de valoración", "default": "4.8 · 312 reseñas" },
    { "type": "header", "content": "Galería" },
    { "type": "image_picker", "id": "image_1", "label": "Imagen 1" },
    { "type": "image_picker", "id": "image_2", "label": "Imagen 2" },
    { "type": "image_picker", "id": "image_3", "label": "Imagen 3" },
    { "type": "image_picker", "id": "image_4", "label": "Imagen 4" },
    { "type": "header", "content": "Formulario" },
    {
      "type": "select", "id": "form_mode", "label": "Datos de entrega", "default": "short",
      "info": "«Solo en el checkout» evita que el cliente escriba su dirección dos veces. Es lo recomendado si usas Dropi u otro proveedor que lee el pedido de Shopify.",
      "options": [
        { "value": "short", "label": "Solo en el checkout (recomendado)" },
        { "value": "full", "label": "También en esta página" }
      ]
    },
    { "type": "text", "id": "form_title", "label": "Título del formulario", "default": "Completa tus datos y recíbelo en casa" },
    { "type": "textarea", "id": "size_help", "label": "Ayuda de tallas", "default": "Elige la misma talla que usas en polos, camisas o blusas. Si estás entre dos, pide la M." },
    {
      "type": "select", "id": "submit_mode", "label": "Al enviar el pedido", "default": "checkout",
      "info": "«Checkout de Shopify» crea un pedido real con los datos del formulario. «WhatsApp» solo abre un chat con el resumen.",
      "options": [
        { "value": "checkout", "label": "Ir al checkout de Shopify (recomendado)" },
        { "value": "whatsapp", "label": "Enviar por WhatsApp" }
      ]
    },
    { "type": "text", "id": "submit_text", "label": "Texto del botón", "default": "Confirmar pedido contraentrega" },
    { "type": "textarea", "id": "reassurance", "label": "Texto de confianza", "default": "No pagas nada ahora. Te llamamos para confirmar la entrega y pagas en efectivo cuando recibas tu pedido." },
    { "type": "text", "id": "payline", "label": "Línea inferior", "default": "Tus datos viajan cifrados y solo se usan para la entrega" },
    { "type": "textarea", "id": "regions", "label": "Departamentos (separados por coma)", "default": "Lima, Callao, Arequipa, La Libertad, Piura, Lambayeque, Cusco, Junín, Áncash, Ica, Cajamarca, Puno, Tacna, Loreto, San Martín, Ucayali, Huánuco, Ayacucho, Apurímac, Amazonas, Huancavelica, Madre de Dios, Moquegua, Pasco, Tumbes" },
    { "type": "header", "content": "Barra fija en móvil" },
    { "type": "checkbox", "id": "show_sticky", "label": "Mostrar barra fija", "default": true },
    { "type": "text", "id": "sticky_text", "label": "Texto del botón fijo", "default": "Pedir ahora" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Punto de venta",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Se ajusta al torso en segundos" }
      ]
    },
    {
      "type": "size",
      "name": "Talla",
      "settings": [
        { "type": "text", "id": "code", "label": "Talla", "default": "S", "info": "Debe coincidir con el nombre de la variante en Shopify (ej. «S» o «M»)." },
        { "type": "text", "id": "range", "label": "Medida", "default": "46 - 68 cm" }
      ]
    },
    {
      "type": "quantity",
      "name": "Opción de cantidad",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "1 unidad" },
        { "type": "text", "id": "qty", "label": "Cantidad", "default": "1" },
        { "type": "text", "id": "price", "label": "Precio mostrado", "default": "S/ 60" },
        { "type": "text", "id": "compare", "label": "Precio tachado", "info": "Solo si el descuento es real. Para un pack, el precio de esas mismas unidades sueltas." },
        { "type": "text", "id": "sub", "label": "Línea de ahorro", "info": "Ej: Ahorras S/ 30 · S/ 45 cada uno" },
        { "type": "text", "id": "badge", "label": "Insignia", "info": "Ej: MÁS PEDIDO" },
        { "type": "checkbox", "id": "featured", "label": "Destacar esta opción", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Producto + contraentrega",
      "blocks": [
        { "type": "feature", "settings": { "text": "Diseño en X de doble ajuste que alinea los hombros sin forzar" } },
        { "type": "feature", "settings": { "text": "Cuero PU acolchado con perforaciones que ventilan la espalda" } },
        { "type": "feature", "settings": { "text": "Dos tallas: S (46-68 cm) y M (68-91 cm), para hombre y mujer" } },
        { "type": "feature", "settings": { "text": "Se usa bajo la ropa o encima · oficina, gimnasio y casa" } },
        { "type": "size", "settings": { "code": "S", "range": "46 - 68 cm" } },
        { "type": "size", "settings": { "code": "M", "range": "68 - 91 cm" } },
        { "type": "quantity", "settings": { "label": "1 unidad", "qty": "1", "price": "S/ 60" } },
        { "type": "quantity", "settings": { "label": "2 unidades", "qty": "2", "price": "S/ 120" } }
      ]
    }
  ]
}
{% endschema %}

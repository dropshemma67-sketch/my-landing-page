<section class="section"><div class="wrap" style="max-width:460px">
  <h1 class="h2 center" style="margin-bottom:1.6rem">Nueva contraseña</h1>
  <div class="glass" style="padding:1.8rem">
    {% form 'reset_customer_password', class: 'cod' %}
      {{ form.errors | default_errors }}
      <div class="field"><label for="rp-1">Contraseña</label><input id="rp-1" type="password" name="customer[password]" required></div>
      <div class="field"><label for="rp-2">Confirmar</label><input id="rp-2" type="password" name="customer[password_confirmation]" required></div>
      <button class="btn btn--warm btn--wide" type="submit"><span class="btn__label">Guardar</span></button>
    {% endform %}
  </div>
</div></section>

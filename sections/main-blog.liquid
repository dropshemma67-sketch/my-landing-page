{%- paginate blog.articles by 12 -%}
<section class="section">
  <div class="wrap">
    <h1 class="h2 center" style="margin-bottom:2.4rem" data-reveal>{{ blog.title }}</h1>
    <div class="grid-3">
      {%- for article in blog.articles -%}
        <a class="glass glass-hover sheen pcard" href="{{ article.url }}" data-reveal data-delay="{{ forloop.index0 | times: 0.06 }}">
          {%- if article.image -%}<img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" width="700" height="700" loading="lazy">{%- endif -%}
          <span class="tiny muted">{{ article.published_at | date: '%d/%m/%Y' }}</span>
          <span class="pcard__t">{{ article.title }}</span>
          <span class="small muted">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</span>
        </a>
      {%- else -%}
        <p class="lead">Aún no hay publicaciones.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:2.4rem">{{ paginate | default_pagination }}</div>{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [] }
{% endschema %}

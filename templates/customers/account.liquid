<section class="section"><div class="wrap" style="max-width:820px">
  <h1 class="h2 center" style="margin-bottom:1.8rem">Mi cuenta</h1>
  <div class="glass" style="padding:1.8rem">
    <p class="muted small">{{ customer.email }} · <a href="{{ routes.account_logout_url }}">Cerrar sesión</a></p>
    <hr class="hairline" style="margin:1.2rem 0">
    {%- if customer.orders.size > 0 -%}
      <table class="cart-table"><thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th style="text-align:right">Total</th></tr></thead><tbody>
        {%- for order in customer.orders -%}
        <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d/%m/%Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td style="text-align:right">{{ order.total_price | money }}</td></tr>
        {%- endfor -%}
      </tbody></table>
    {%- else -%}
      <p class="muted">Todavía no tienes pedidos.</p>
    {%- endif -%}
    <p class="small" style="margin-top:1.2rem"><a href="{{ routes.account_addresses_url }}">Mis direcciones</a></p>
  </div>
</div></section>

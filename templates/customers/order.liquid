<section class="section"><div class="wrap" style="max-width:820px">
  <h1 class="h2 center" style="margin-bottom:1.8rem">Pedido {{ order.name }}</h1>
  <div class="glass" style="padding:1.8rem">
    <p class="muted small">{{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
    <hr class="hairline" style="margin:1.2rem 0">
    <table class="cart-table"><tbody>
      {%- for line_item in order.line_items -%}
        <tr><td>{{ line_item.title }} × {{ line_item.quantity }}</td><td style="text-align:right">{{ line_item.final_line_price | money }}</td></tr>
      {%- endfor -%}
      <tr><td><b>Total</b></td><td style="text-align:right"><b>{{ order.total_price | money }}</b></td></tr>
    </tbody></table>
    <div class="rte small" style="margin-top:1.4rem">{{ order.shipping_address | format_address }}</div>
  </div>
</div></section>

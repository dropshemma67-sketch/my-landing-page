<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {%- liquid
    assign head_font = settings.type_header_font
    assign body_font = settings.type_body_font
  -%}
  {{ head_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  <style>
    :root {
      --bg: {{ settings.color_bg }}; --bg-2: {{ settings.color_bg_2 }};
      --text: {{ settings.color_text }}; --muted: {{ settings.color_muted }};
      --warm: {{ settings.color_warm }}; --warm-2: {{ settings.color_warm_light }};
      --bronze: {{ settings.color_bronze }};
      --font-head: {{ head_font.family }}, {{ head_font.fallback_families }};
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body>
  <div class="aura"><span class="aura__blob aura__blob--1"></span><span class="aura__blob aura__blob--2"></span></div>
  <main class="section" style="position:relative;z-index:2;min-height:100vh;display:grid;place-items:center">
    <div class="wrap center stack" style="max-width:520px">
      <p class="logo grad-warm" style="justify-content:center">{{ shop.name }}</p>
      <h1 class="h2">Estamos afinando los últimos detalles</h1>
      <p class="lead" style="margin-inline:auto">Muy pronto abrimos. Déjanos tu correo y te avisamos primero.</p>
      <div class="glass" style="padding:1.6rem;margin-top:1rem">
        {% form 'customer', class: 'stack' %}
          <input type="hidden" name="contact[tags]" value="prelaunch">
          <div class="field"><label for="pw-email">Tu correo</label>
            <input id="pw-email" type="email" name="contact[email]" placeholder="tucorreo@ejemplo.com" required></div>
          <button class="btn btn--warm btn--wide" type="submit"><span class="btn__label">Avísenme</span></button>
          {%- if form.posted_successfully? -%}<p class="small" style="color:var(--warm-2)">¡Gracias! Te escribiremos pronto.</p>{%- endif -%}
        {% endform %}
      </div>
      <div style="margin-top:1.4rem">{{ powered_by_link }}</div>
    </div>
  </main>
</body>
</html>
